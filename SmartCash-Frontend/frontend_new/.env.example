# Copia este archivo como ".env" (cp .env.example .env) y ajusta si cambias puertos.
# Solo variables VITE_ (son públicas en el navegador): NUNCA pongas contraseñas ni claves aquí.
# Son los destinos del proxy de Vite en desarrollo (npm run dev). En Docker, nginx hace ese papel.
VITE_PROXY_AUTH=http://localhost:8081
VITE_PROXY_TRANSACCIONES=http://localhost:8082
VITE_PROXY_ANALITICA=http://localhost:8084
VITE_PROXY_CATEGORIZACION=http://localhost:8000
